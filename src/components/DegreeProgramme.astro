---
import { degreeProgrammes } from "@/data/degree-programmes";

type Props = {
  readonly degree: string;
};

const { degree } = Astro.props;
const programme = degreeProgrammes[degree];
---

{
  programme && (
    <section class="mt-6" aria-label={`Programme · ${degree}`}>
      <p class="text-muted-foreground text-sm">
        {programme.department} · {programme.cohort} cohort
      </p>
      <p class="reading-copy mt-3">{programme.overview}</p>
      <div class="mt-6 grid gap-5 md:grid-cols-2">
        {programme.areas.map(area => (
          <div class="border-border border-t pt-4 text-start">
            <h4 class="text-accent font-semibold">{area.title}</h4>
            <p class="mt-2 text-sm leading-relaxed">{area.description}</p>
          </div>
        ))}
      </div>
      <dl class="border-border mt-6 grid gap-5 border-t pt-4 text-start md:grid-cols-2">
        {programme.structure.map(item => (
          <div>
            <dt class="font-semibold">{item.term}</dt>
            <dd class="text-muted-foreground mt-1 text-sm leading-relaxed">
              {item.detail}
            </dd>
          </div>
        ))}
      </dl>
      <a
        class="text-link mt-5 inline-flex min-h-11 items-center underline underline-offset-4"
        href={programme.cohortUrl}
        rel="noopener noreferrer"
      >
        Official study plan · {programme.cohort} cohort
        <span aria-hidden="true" class="ms-1">
          ↗
        </span>
        <span class="sr-only"> on the University of Catania website</span>
      </a>
    </section>
  )
}
