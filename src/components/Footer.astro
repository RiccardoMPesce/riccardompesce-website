---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";
import ShareLinks from "./ShareLinks.astro";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const currentYear = new Date().getFullYear();
---

<footer
  data-pagefind-ignore
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="border-border border-t py-6 md:py-4">
    <div
      class="flex flex-col items-center gap-3 pb-4 md:flex-row md:items-start md:justify-between md:gap-6"
    >
      <ShareLinks
        url={config.site.url}
        title={config.site.title}
        scope="site"
      />
      <div class="min-w-0 text-center md:text-end">
        <div
          class="flex items-center justify-center gap-2 md:min-h-11 md:justify-end"
        >
          <span class="text-muted-foreground text-sm">{t.sharing.profiles}</span
          >
          <Socials horizontal />
        </div>
      </div>
    </div>
    <div
      class="text-muted-foreground grid min-w-0 gap-3 text-center text-sm md:grid-cols-[1fr_auto] md:items-start md:gap-6 md:text-start"
    >
      <div class="flex flex-col">
        <span
          >{t.footer.copyright} &#169; {currentYear} {config.site.author}.</span
        >
        <span>{t.footer.allRightsReserved}</span>
      </div>
      <p class="md:text-end">
        {t.footer.builtWith}{" "}
        <a href="https://astro.build/" class="underline underline-offset-4"
          >Astro</a
        >
        {" "}&middot; {t.footer.basedOn}{" "}
        <a
          href="https://github.com/satnaing/astro-paper"
          class="underline underline-offset-4">AstroPaper</a
        >
      </p>
    </div>
  </div>
</footer>
