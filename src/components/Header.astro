---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconUnderline from "@/assets/icons/IconUnderline.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconArchive from "@/assets/icons/IconArchive.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { stripBase, stripLocale } from "@/utils/withBase";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

// Strip the base prefix so isActive comparisons work regardless of deploy subdirectory.
// e.g. with base "/blog": "/blog/posts/slug" → "/posts/slug"
const relativePath = stripBase(Astro.url.pathname);
const pathWithoutTrailingSlash =
  relativePath.endsWith("/") && relativePath !== "/"
    ? relativePath.slice(0, -1)
    : relativePath;

const currentPath = stripLocale(pathWithoutTrailingSlash, locale);

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());
  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<noscript>
  <style is:inline>
    #menu-items {
      display: grid !important;
    }
    #menu-btn,
    #theme-btn {
      display: none !important;
    }
    @media (min-width: 768px) {
      #menu-items {
        display: flex !important;
      }
    }
  </style>
</noscript>

<header
  data-pagefind-ignore
  class="app-layout flex flex-col items-center justify-between md:flex-row"
>
  <div
    class="border-border bg-background relative flex w-full flex-col items-center gap-3 border-b py-4 md:flex-row md:justify-between md:gap-0 md:py-6"
  >
    <a
      href={getRelativeLocaleUrl(locale, "")}
      class="py-1 text-center text-xl leading-8 font-semibold break-words md:my-auto md:text-start md:text-xl md:leading-none md:whitespace-nowrap"
    >
      {site.title}
    </a>
    <nav
      id="nav-menu"
      aria-label="Main navigation"
      class="flex w-full flex-col items-center md:ms-2 md:flex-row md:justify-end md:space-x-4 md:py-0"
    >
      <button
        id="menu-btn"
        type="button"
        class="focus-outline size-12 shrink-0 self-center p-3 md:hidden"
        aria-label={t.a11y.openMenu}
        aria-expanded="false"
        aria-controls="menu-items"
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
      >
        <IconX
          id="close-icon"
          class="hidden"
          aria-hidden="true"
          focusable="false"
        />
        <IconMenuDeep id="menu-icon" aria-hidden="true" focusable="false" />
      </button>
      <ul
        id="menu-items"
        class="[&>li>a]:hover:text-accent mt-4 hidden w-full grid-cols-1 place-content-center gap-2 md:mt-0 md:flex md:w-auto md:gap-x-2 md:gap-y-0 md:[&>li]:min-h-8 [&>li>a]:block [&>li>a]:px-4 [&>li>a]:py-3 [&>li>a]:text-center [&>li>a]:font-medium md:[&>li>a]:px-2 md:[&>li>a]:py-1"
      >
        <li class="col-span-1">
          <a
            href={getRelativeLocaleUrl(locale, "")}
            class:list={{ "active-nav": isActive("/") }}
            aria-current={isActive("/") ? "page" : undefined}
          >
            {t.nav.home}
          </a>
        </li>
        <li class="col-span-1">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class:list={{ "active-nav": isActive("/posts") }}
            aria-current={isActive("/posts") ? "page" : undefined}
          >
            {t.nav.posts}
          </a>
        </li>
        <li class="col-span-1">
          <a
            href={getRelativeLocaleUrl(locale, "about")}
            class:list={{ "active-nav": isActive("/about") }}
            aria-current={isActive("/about") ? "page" : undefined}
          >
            {t.nav.about}
          </a>
        </li>
        <li class="col-span-1">
          <a
            href={getRelativeLocaleUrl(locale, "portfolio")}
            class:list={{ "active-nav": isActive("/portfolio") }}
            aria-current={isActive("/portfolio") ? "page" : undefined}
          >
            {t.nav.portfolio}
          </a>
        </li>
        <li class="col-span-1">
          <a
            href={getRelativeLocaleUrl(locale, "contacts")}
            class:list={{ "active-nav": isActive("/contacts") }}
            aria-current={isActive("/contacts") ? "page" : undefined}
          >
            {t.nav.contacts}
          </a>
        </li>
        {
          features.showArchives && (
            <li class="col-span-1">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "archives")}
                class:list={[
                  "focus-outline flex size-full justify-center p-3 md:relative md:size-8 md:p-0",
                  { "active-nav": isActive("/archives") },
                ]}
                title={t.nav.archives}
                aria-label={t.nav.archives}
              >
                <IconArchive
                  aria-hidden="true"
                  focusable="false"
                  class="hidden md:absolute md:top-1/2 md:left-1/2 md:block md:size-6 md:-translate-x-1/2 md:-translate-y-1/2"
                />
                <span class="md:sr-only">{t.nav.archives}</span>
                {isActive("/archives") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="scale-125 max-md:hidden md:absolute md:bottom-0 md:w-6"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.search !== false && (
            <li class="col-span-1 flex items-center justify-center">
              <LinkButton
                href={getRelativeLocaleUrl(locale, "search")}
                class:list={["focus-outline relative size-8"]}
                title={t.nav.search}
                aria-label={t.nav.search}
              >
                <IconSearch
                  aria-hidden="true"
                  focusable="false"
                  class="absolute top-1/2 left-1/2 size-6 -translate-x-1/2 -translate-y-1/2"
                />
                <span class="sr-only">{t.nav.search}</span>
                {isActive("/search") && (
                  <IconUnderline
                    aria-hidden="true"
                    class="absolute bottom-0 w-6 scale-125 max-md:inset-s-2"
                  />
                )}
              </LinkButton>
            </li>
          )
        }
        {
          features.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline hover:[&_svg]:stroke-accent flex min-h-12 w-full flex-col items-center justify-center gap-2 px-4 py-3 md:size-8 md:min-h-0 md:p-0"
                title={t.a11y.toggleTheme}
                aria-label={t.a11y.toggleTheme}
              >
                <span class="relative block size-6" aria-hidden="true">
                  <IconMoon
                    aria-hidden="true"
                    focusable="false"
                    class="absolute top-[50%] left-[50%] translate-[-50%] scale-100 rotate-0 motion-safe:transition-transform dark:scale-0 dark:-rotate-90"
                  />
                  <IconSunHigh
                    aria-hidden="true"
                    focusable="false"
                    class="absolute top-[50%] left-[50%] translate-[-50%] scale-0 rotate-90 motion-safe:transition-transform dark:scale-100 dark:rotate-0"
                  />
                </span>
                <span class="text-sm font-medium md:sr-only">Theme</span>
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  import "@/scripts/navigation";
</script>
