---
import type { portfolio } from "@/data/portfolio";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";

interface Props {
  readonly projects: readonly (typeof portfolio.projects)[number][];
}

const { projects } = Astro.props;
if (!projects.length)
  throw new Error("The project carousel requires at least one project.");
---

<project-carousel class="mt-7 block min-w-0" aria-label="Selected projects">
  <div data-project-controls hidden>
    <div class="project-preview-navigation">
      <button
        type="button"
        class="project-arrow"
        data-project-preview-previous
        aria-label="Scroll project previews left"
        aria-controls="project-preview-list"
        ><IconArrowLeft aria-hidden="true" focusable="false" /></button
      >
      <div
        id="project-preview-list"
        class="project-previews"
        data-project-previews
        aria-label="Project previews"
      >
        <div class="project-preview-track">
          {
            projects.map((project, index) => (
              <button
                type="button"
                class="project-preview"
                id={`project-preview-${index}`}
                data-project-preview
                aria-controls={`project-slide-${index}`}
              >
                <span class="block text-sm font-semibold">{project.name}</span>
                <span class="text-muted-foreground block text-xs leading-relaxed">
                  {project.role} · {project.tools.slice(0, 2).join(" · ")}
                </span>
              </button>
            ))
          }
        </div>
      </div>
      <button
        type="button"
        class="project-arrow"
        data-project-preview-next
        aria-label="Scroll project previews right"
        aria-controls="project-preview-list"
        ><IconArrowRight aria-hidden="true" focusable="false" /></button
      >
    </div>
  </div>
  <div class="project-viewport" data-project-viewport>
    {
      projects.map((project, index) => (
        <article
          id={`project-slide-${index}`}
          data-project-slide
          class="project-slide"
          aria-labelledby={`project-title-${index}`}
        >
          <div class="project-card">
            <p class="text-muted-foreground font-mono text-xs font-medium tracking-[0.06em] uppercase">
              {project.role}
            </p>
            <h3
              id={`project-title-${index}`}
              class="mt-3 text-xl font-semibold"
            >
              {project.name}
            </h3>
            <p class="reading-copy mt-3 max-md:mx-auto max-md:text-center">
              {project.description}
            </p>
            <ul
              class="mt-4 flex flex-col items-center gap-2 md:flex-row md:flex-wrap md:items-start"
              aria-label={`${project.name} technologies`}
            >
              {project.tools.map(tool => (
                <li class="project-skill">{tool}</li>
              ))}
            </ul>
            <a
              href={project.url}
              class="text-accent mt-5 inline-block underline underline-offset-4"
            >
              Explore {project.name} on GitHub <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))
    }
  </div>
  <div data-project-navigation hidden>
    <div class="mt-5 flex items-center justify-center gap-4">
      <button
        type="button"
        class="project-arrow"
        data-project-previous
        aria-label="Previous project"
        ><IconArrowLeft aria-hidden="true" focusable="false" /></button
      >
      <p
        class="text-muted-foreground text-sm"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-project-status
      >
        Project 1 of {projects.length}
      </p>
      <button
        type="button"
        class="project-arrow"
        data-project-next
        aria-label="Next project"
        ><IconArrowRight aria-hidden="true" focusable="false" /></button
      >
    </div>
  </div>
</project-carousel>

<script>
  import "@/scripts/project-carousel";
</script>

<style>
  @reference "../styles/global.css";

  .project-preview-navigation {
    @apply mb-5 grid items-center gap-2;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
  }
  .project-previews {
    @apply min-w-0 overflow-x-auto p-1;
    scrollbar-width: thin;
    scroll-snap-type: x proximity;
    overscroll-behavior-x: contain;
  }
  .project-preview-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    inline-size: max-content;
    margin-inline: auto;
    gap: 0.75rem;
  }
  .project-preview {
    @apply border-border bg-surface hover:bg-muted flex flex-col justify-center gap-1 rounded-lg border-2 px-4 py-3 text-center md:text-start;
    max-inline-size: min(24rem, calc(100vw - 9rem));
    min-block-size: 72px;
    scroll-snap-align: start;
  }
  .project-preview[aria-selected="true"] {
    @apply border-accent bg-muted;
  }
  .project-viewport {
    @apply grid gap-4;
  }
  project-carousel[data-enhanced] .project-viewport {
    @apply flex min-w-0 gap-0 overflow-x-auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
  }
  project-carousel[data-enhanced] :is(.project-previews, .project-viewport) {
    cursor: grab;
  }
  project-carousel[data-enhanced]
    :is(.project-previews, .project-viewport)[data-dragging] {
    cursor: grabbing;
    user-select: none;
    scroll-snap-type: none;
  }
  .project-slide {
    @apply min-w-0 shrink-0;
    flex-basis: 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  .project-card {
    @apply border-border bg-surface h-full rounded-xl border p-5 sm:p-6;
  }
  .project-skill {
    @apply bg-muted text-foreground rounded-md px-2.5 py-1 text-xs leading-relaxed;
  }
  .project-arrow {
    @apply border-input-border hover:bg-muted inline-flex size-11 items-center justify-center rounded-full border disabled:cursor-default disabled:opacity-40;
  }
  project-carousel :is(button, a):focus-visible {
    @apply outline-accent outline-2 outline-offset-2 outline-solid;
  }
  @media print {
    [data-project-controls],
    [data-project-navigation] {
      display: none;
    }
    project-carousel[data-enhanced] .project-viewport {
      display: grid;
      overflow: visible;
    }
  }
</style>
