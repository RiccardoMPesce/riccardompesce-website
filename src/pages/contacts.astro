---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";
---

<Layout
  title={`Contacts | ${config.site.title}`}
  description="Get in touch with Riccardo M. Pesce by email, on LinkedIn or on GitHub."
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle="Contacts"
    pageDesc="For projects, roles and technical conversations."
  >
    <p class="reading-copy max-md:mx-auto max-md:text-center">
      Have a technical challenge, a project idea or a question about something
      I’ve written? Tell me what you’re trying to do, the constraints you’re
      working with and where you’d like another perspective.
    </p>
    <section
      class="border-border bg-surface mt-10 rounded-xl border p-5 text-center sm:p-8 md:text-start"
      aria-labelledby="contact-form-title"
    >
      <h2 id="contact-form-title" class="text-accent text-xl font-semibold">
        Tell me what you have in mind.
      </h2>
      <p class="text-muted-foreground mt-2 text-sm">All fields are required.</p>
      <form
        action="https://formsubmit.co/a93524a639ac2bbe227f1cdd5cb3f824"
        method="POST"
        class="contact-form mt-6 grid max-w-xl gap-5"
        aria-describedby="contact-form-privacy"
      >
        <input
          type="hidden"
          name="_subject"
          value="New message from riccardompesce.com"
        />
        <input type="hidden" name="_template" value="table" />
        <div class="grid gap-2">
          <label for="contact-name" class="font-medium">Your name</label>
          <input
            id="contact-name"
            name="name"
            type="text"
            autocomplete="name"
            maxlength="100"
            required
          />
        </div>
        <div class="grid gap-2">
          <label for="contact-email" class="font-medium">Your email</label>
          <input
            id="contact-email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
          />
        </div>
        <div class="grid gap-2">
          <label for="contact-message" class="font-medium">Your message</label>
          <textarea
            id="contact-message"
            name="message"
            rows="7"
            minlength="10"
            maxlength="5000"
            aria-describedby="contact-message-hint"
            required></textarea>
          <p id="contact-message-hint" class="text-muted-foreground text-sm">
            Between 10 and 5,000 characters.
          </p>
        </div>
        <p id="contact-form-privacy" class="text-muted-foreground text-sm">
          Your name, email and message are sent through{" "}
          <a
            href="https://formsubmit.co/"
            class="text-accent underline decoration-solid underline-offset-4"
            >FormSubmit</a
          >{" "}to my inbox. You’ll continue to FormSubmit to complete the spam
          check and submission. You can also email me directly below.
        </p>
        <button
          type="submit"
          class="bg-accent text-accent-foreground hover:bg-accent-hover focus-visible:outline-accent w-fit rounded-lg px-5 py-3 font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-solid motion-safe:transition-colors"
        >
          Send message
        </button>
      </form>
    </section>
    <ul class="border-border mt-8 divide-y border-y">
      <li class="py-5 text-center md:text-start">
        <p class="text-muted-foreground mb-1 text-sm">Email</p>
        <p class="mb-2">Start a conversation about a problem or a project.</p>
        <!--email_off-->
        <a
          class="text-accent break-all underline decoration-solid underline-offset-4"
          href="mailto:riccardompesce@gmail.com"
          target="_blank"
          rel="noopener noreferrer"
          >riccardompesce@gmail.com <span aria-hidden="true">↗</span><span
            class="sr-only"
          >
            (opens your email app or a new tab)</span
          ></a
        ><!--/email_off-->
      </li>
      <li class="py-5 text-center md:text-start">
        <p class="text-muted-foreground mb-1 text-sm">LinkedIn</p>
        <p class="mb-2">Connect around work, experience and opportunities.</p>
        <a
          class="text-accent underline decoration-solid underline-offset-4"
          href="https://www.linkedin.com/in/riccardomariapesce/"
          >riccardomariapesce <span aria-hidden="true">↗</span></a
        >
      </li>
      <li class="py-5 text-center md:text-start">
        <p class="text-muted-foreground mb-1 text-sm">GitHub</p>
        <p class="mb-2">Explore the code and repositories I share.</p>
        <a
          class="text-accent underline decoration-solid underline-offset-4"
          href="https://github.com/riccardompesce"
          >riccardompesce <span aria-hidden="true">↗</span></a
        >
      </li>
    </ul>
  </Main>
  <Footer />
</Layout>

<style>
  @reference "../styles/global.css";

  .contact-form :is(input:not([type="hidden"]), textarea) {
    @apply border-input-border bg-background text-foreground focus-visible:outline-accent w-full min-w-0 rounded-lg border px-3 py-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solid;
  }

  .contact-form textarea {
    resize: vertical;
  }
  @media (width < 48rem) {
    .contact-form {
      margin-inline: auto;
    }
    .contact-form :is(input:not([type="hidden"]), textarea) {
      text-align: center;
    }
    .contact-form button[type="submit"] {
      justify-self: center;
    }
  }
</style>
