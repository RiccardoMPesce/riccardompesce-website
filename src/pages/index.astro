---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Portrait from "@/components/Portrait.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    tabindex="-1"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-12 text-center md:text-start"
  >
    <section
      aria-labelledby="intro-title"
      class="border-border border-b py-16 sm:py-24"
    >
      <div
        class="flex flex-col gap-6 md:flex-row-reverse md:items-center md:justify-between md:gap-8"
      >
        <Portrait />
        <div class="min-w-0">
          <p class="text-muted-foreground mb-5 text-sm">
            Engineering, curiosity and purposeful work.
          </p>
          <h1
            id="intro-title"
            class="max-w-xl text-4xl leading-tight font-semibold tracking-tight max-md:mx-auto sm:text-5xl"
          >
            Hey there, I’m Riccardo.
          </h1>
        </div>
      </div>
      <p
        class="reading-copy text-muted-foreground mt-6 max-md:mx-auto max-md:text-center"
      >
        My work spans complex systems engineering, business analysis and
        technical leadership. I’m interested in how the pieces fit together,
        from the flow of data to the decisions people make. Here, I share what I
        build and learn.
      </p>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class="text-accent mt-7 inline-block underline decoration-solid underline-offset-4"
      >
        The experience and direction behind the work <span aria-hidden="true"
          >↗</span
        >
      </a>
    </section>

    <section aria-labelledby="latest-title" class="pt-10 sm:pt-12">
      <div
        class="flex flex-col items-center gap-4 md:flex-row md:flex-wrap md:items-baseline md:justify-between"
      >
        <h2 id="latest-title" class="text-xl font-semibold">Latest writing</h2>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-accent text-sm underline decoration-solid underline-offset-4"
        >
          All posts <span aria-hidden="true">→</span>
        </a>
      </div>
      {
        posts.length > 0 ? (
          <ul>
            {posts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground mt-6">
            New writing will appear here.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("#main-content");
    if (main?.dataset.layout === "index" && main.dataset.homePath) {
      sessionStorage.setItem("backUrl", main.dataset.homePath);
    }
  });
</script>
