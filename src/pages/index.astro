---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-12"
  >
    <section
      aria-labelledby="intro-title"
      class="border-border border-b py-16 sm:py-24"
    >
      <p class="text-muted-foreground mb-5 text-sm">
        Riccardo's presence in the web
      </p>
      <h1
        id="intro-title"
        class="max-w-xl text-4xl leading-tight font-semibold tracking-tight sm:text-5xl"
      >
        Hey there, I’m Riccardo.
      </h1>
      <p class="text-muted-foreground mt-6 max-w-xl text-lg leading-relaxed">
        I’m interested in complex systems and how things work. This is where I
        share what I build, explore and learn along the way.
      </p>
      <a
        href={getRelativeLocaleUrl(locale, "about")}
        class="text-accent mt-7 inline-block underline decoration-solid underline-offset-4"
      >
        A little more about me <span aria-hidden="true">↗</span>
      </a>
    </section>

    <section aria-labelledby="latest-title" class="pt-10 sm:pt-12">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 id="latest-title" class="text-xl font-semibold">Latest writing</h2>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-accent text-sm underline decoration-solid underline-offset-4"
        >
          All posts <span aria-hidden="true">→</span>
        </a>
      </div>
      {
        posts.length > 0 ? (
          <ul>
            {posts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground mt-6">
            New writing will appear here.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("#main-content");
    if (main?.dataset.layout === "index" && main.dataset.homePath) {
      sessionStorage.setItem("backUrl", main.dataset.homePath);
    }
  });
</script>
