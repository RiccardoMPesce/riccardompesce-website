---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const posts = getSortedPosts(await getCollection("posts")).slice(
  0,
  config.posts.perIndex
);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    tabindex="-1"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout pb-12 text-center md:text-start"
  >
    <section
      aria-labelledby="intro-title"
      class="border-border border-b py-16 sm:py-24"
    >
      <p class="eyebrow text-accent mb-5">
        From first principles to working systems
      </p>
      <h1
        id="intro-title"
        class="max-w-2xl text-4xl leading-tight font-semibold max-md:mx-auto sm:text-5xl"
      >
        Notes, models, and architectures across digital and physical systems.
      </h1>
      <p class="reading-copy text-muted-foreground mt-6 max-md:mx-auto">
        A personal space for technical notes, analyses, and engineering
        projects.
      </p>
      <div
        class="mt-7 flex flex-wrap items-center justify-center gap-4 md:justify-start"
      >
        <a
          href={getRelativeLocaleUrl(locale, "portfolio")}
          class="bg-accent text-accent-foreground hover:bg-accent-hover inline-flex min-h-11 items-center rounded-lg px-4 py-2 text-sm font-semibold"
        >
          Portfolio
        </a>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-link inline-flex min-h-11 items-center px-2 text-sm"
        >
          Blog
        </a>
      </div>
    </section>

    <section aria-labelledby="latest-title" class="pt-10 sm:pt-12">
      <div
        class="flex flex-col items-center gap-4 md:flex-row md:flex-wrap md:items-baseline md:justify-between"
      >
        <h2 id="latest-title" class="text-xl font-semibold">Recent Posts</h2>
        <a
          href={getRelativeLocaleUrl(locale, "posts")}
          class="text-accent text-sm underline decoration-solid underline-offset-4"
        >
          All posts <span aria-hidden="true">→</span>
        </a>
      </div>
      {
        posts.length > 0 ? (
          <ul>
            {posts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        ) : (
          <p class="text-muted-foreground mt-6">
            New writing will appear here.
          </p>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const main = document.querySelector<HTMLElement>("#main-content");
    if (main?.dataset.layout === "index" && main.dataset.homePath) {
      sessionStorage.setItem("backUrl", main.dataset.homePath);
    }
  });
</script>
