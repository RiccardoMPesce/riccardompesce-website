---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Portrait from "@/components/Portrait.astro";
import ProjectCarousel from "@/components/ProjectCarousel.astro";
import ResumeDownload from "@/components/ResumeDownload.astro";
import IconListTree from "@/assets/icons/IconListTree.svg";
import { portfolio } from "@/data/portfolio";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sections = [
  { id: "summary", label: "Summary" },
  { id: "experience", label: "Experience" },
  { id: "education", label: "Education" },
  { id: "projects", label: "Projects" },
  { id: "capabilities", label: "Skills" },
] as const;
---

<Layout
  title={`Portfolio | ${config.site.title}`}
  description="Riccardo M. Pesce’s career across technical leadership, systems engineering, data and business solutions. Explore experience, skills and education."
>
  <Header />
  <Breadcrumb />
  <main id="main-content" tabindex="-1" class="app-layout portfolio pb-16">
    <section class="py-6 sm:py-8" aria-labelledby="portfolio-title">
      <div
        class="flex flex-col gap-6 md:flex-row-reverse md:items-center md:justify-between md:gap-8"
      >
        <Portrait />
        <div class="min-w-0">
          <p class="eyebrow">Riccardo M. Pesce · Catania, Italy</p>
          <h1
            id="portfolio-title"
            class="mt-3 text-3xl font-semibold sm:text-4xl"
          >
            Portfolio
          </h1>
        </div>
      </div>
    </section>

    <portfolio-tabs class="block">
      <span data-navigation-sentinel class="block h-px" aria-hidden="true"
      ></span>
      <div class="section-navigation" data-section-navigation>
        <div class="navigation-bar" data-navigation-bar>
          <div
            class="navigation-actions mb-3 flex flex-col items-center gap-3 md:flex-row md:items-center md:justify-between"
          >
            <p class="eyebrow" id="portfolio-sections-label">
              Explore the portfolio
            </p>
            <div class="flex flex-wrap items-center justify-center gap-2">
              <button type="button" class="full-cv-button" data-view-all hidden>
                <IconListTree
                  class="size-5 shrink-0"
                  aria-hidden="true"
                  focusable="false"
                />
                View full CV
              </button>
              <ResumeDownload />
            </div>
          </div>
          <div
            class="section-nav"
            data-tablist
            aria-labelledby="portfolio-sections-label"
          >
            {
              sections.map(section => (
                <a id={`tab-${section.id}`} href={`#${section.id}`}>
                  {section.label}
                </a>
              ))
            }
          </div>
        </div>
      </div>
      <section
        id="summary"
        class="portfolio-section"
        data-tab-panel
        aria-labelledby="summary-title"
      >
        <p class="eyebrow">Summary</p>
        <h2 id="summary-title" class="section-title">
          From systems engineering to technical leadership and B2B decisions.
        </h2>
        <p class="reading-copy text-muted-foreground mt-6">
          Computer Engineer (M.Sc., 110/110 cum laude). 
          I work where architecture, data, and applied 
          AI meet real operational constraints—turning 
          technical trade-offs into clear commercial 
          decisions across complex, high-reliability 
          environments.
        </p>
        <div
          class="mt-7 flex flex-col items-stretch gap-5 md:flex-row md:flex-wrap md:items-center"
        >
          <a href="#experience" class="primary-link">
            Explore my experience <span aria-hidden="true">↓</span>
          </a>
          <a href={getRelativeLocaleUrl(locale, "contacts")} class="text-link">
            Let’s talk <span aria-hidden="true">↗</span>
          </a>
        </div>
        <dl class="border-border mt-10 grid gap-5 border-t pt-6 md:grid-cols-3">
          <div>
            <dt class="eyebrow">Engineering</dt>
            <dd class="mt-2 font-medium">M.Sc. · 110/110 with honours</dd>
          </div>
          <div>
            <dt class="eyebrow">Experience</dt>
            <dd class="mt-2 font-medium">Technical & commercial</dd>
          </div>
          <div>
            <dt class="eyebrow">Languages</dt>
            <dd class="mt-2 font-medium">Italian · English C1</dd>
          </div>
        </dl>
        <details class="content-card mt-8">
          <summary class="text-link w-fit cursor-pointer"
            >Community involvement</summary
          >
          <p class="mt-4 text-sm leading-relaxed">
            Alongside my studies, my academic activities and associations
            included EESTEC and GDG Catania.
          </p>
          <ul class="mt-4 grid gap-4">
            {
              portfolio.community.map(activity => (
                <li class="border-border border-t pt-4">
                  <h3 class="font-semibold">{activity.role}</h3>
                  <p class="text-muted-foreground mt-2 text-sm">
                    {activity.organization} · {activity.period}
                  </p>
                </li>
              ))
            }
          </ul>
        </details>
      </section>

      <section
        id="experience"
        data-tab-panel
        class="portfolio-section"
        aria-labelledby="experience-title"
      >
        <p class="eyebrow">Experience</p>
        <h2 id="experience-title" class="section-title">
          Experience connecting engineering, people and business needs.
        </h2>
        <p class="section-intro">
          From commercial analysis and data integration to systems engineering
          and technical ownership. Open a role to explore the work and tools
          behind it.
        </p>
        <portfolio-explorer class="mt-7 block">
          <div data-controls hidden>
            <div
              class="mb-6 flex flex-col items-center gap-3 text-sm md:flex-row md:flex-wrap md:items-center md:justify-between"
            >
              <p class="text-muted-foreground">
                {portfolio.experiences.length} roles
              </p>
              <button
                type="button"
                data-expand
                class="text-link"
                aria-controls="experience-list"
              >
                Expand all roles
              </button>
            </div>
          </div>
          <ol id="experience-list" class="experience-timeline grid gap-4">
            {
              portfolio.experiences.map((experience, index) => (
                <li id={experience.id} data-experience>
                  <details class="experience-card" open={index === 0}>
                    <summary>
                      <span class="text-muted-foreground block font-mono text-sm tabular-nums">
                        {experience.period}
                      </span>
                      <span class="mt-2 flex flex-col items-center gap-4 md:flex-row md:items-start md:justify-between">
                        <span>
                          <span class="text-accent block text-sm font-semibold">
                            {experience.employer}
                          </span>
                          <span class="mt-1 block text-lg leading-snug font-semibold sm:text-xl">
                            {experience.role}
                          </span>
                        </span>
                        <span class="disclosure-icon" aria-hidden="true">
                          +
                        </span>
                      </span>
                      <span class="text-muted-foreground mt-3 block text-sm">
                        {experience.location}
                      </span>
                      <span class="role-overview reading-copy mt-3 block">
                        {experience.summary}
                      </span>
                    </summary>
                    <div class="experience-body">
                      <div class="role-contributions">
                        <h3 class="font-semibold">Contributions</h3>
                        <ul class="contributions mt-3">
                          {experience.contributions.map(contribution => (
                            <li>{contribution}</li>
                          ))}
                        </ul>
                      </div>
                      <div class="role-tools">
                        <h3 class="text-sm font-semibold">
                          Tools & technologies
                        </h3>
                        <ul
                          class="mt-3 flex flex-col items-center gap-2 md:flex-row md:flex-wrap md:items-start"
                          aria-label={`Tools used at ${experience.employer}`}
                        >
                          {experience.tools.map(tool => (
                            <li class="skill-tag">{tool}</li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </details>
                </li>
              ))
            }
          </ol>
        </portfolio-explorer>
      </section>

      <section
        id="education"
        data-tab-panel
        class="portfolio-section"
        aria-labelledby="education-title"
      >
        <p class="eyebrow">Education</p>
        <h2 id="education-title" class="section-title">
          Computer engineering, automation and control.
        </h2>
        <p class="section-intro">
          Academic foundations in automation, control, electronics, networks and
          computing. The subjects below describe university study, distinct from
          the professional work above.
        </p>
        <div class="mt-7 grid gap-4">
          {
            portfolio.education.map(education => (
              <article class="content-card">
                <div class="flex flex-col items-center gap-3 md:flex-row md:flex-wrap md:items-baseline md:justify-between">
                  <h3 class="text-lg font-semibold">{education.degree}</h3>
                  <span class="text-muted-foreground text-sm">
                    {education.year}
                  </span>
                </div>
                <p class="text-muted-foreground mt-2">
                  {education.institution}
                </p>
                {"result" in education && (
                  <p class="text-accent mt-3 font-semibold">
                    {education.result}
                  </p>
                )}
                <details
                  class="thesis-panel mt-6"
                  aria-label={`Thesis · ${education.degree}`}
                >
                  <summary class="flex cursor-pointer list-none flex-col items-center gap-3 rounded-sm md:flex-row md:items-start md:justify-between">
                    <span>
                      <span class="block font-semibold">
                        {education.thesis.label}
                      </span>
                      {education.thesis.title && (
                        <span class="mt-2 block text-lg font-semibold">
                          {education.thesis.title}
                        </span>
                      )}
                    </span>
                    <span class="disclosure-icon" aria-hidden="true">
                      +
                    </span>
                  </summary>
                  <div class="mt-4">
                    <p class="text-muted-foreground text-sm">
                      Year {education.thesis.year} · {education.thesis.credits}{" "}
                      credits
                    </p>
                    {education.thesis.sections.map(section => (
                      <section class="mt-6" aria-label={section.heading}>
                        <h4 class="font-semibold">{section.heading}</h4>
                        {section.paragraphs.map(paragraph => (
                          <p class="reading-copy mt-3">{paragraph}</p>
                        ))}
                      </section>
                    ))}
                  </div>
                </details>
                <details class="coursework mt-5">
                  <summary class="text-link w-fit cursor-pointer">
                    Explore {education.coursework.length} coursework activities
                  </summary>
                  <p class="text-muted-foreground mt-4 text-sm leading-relaxed">
                    Course titles and credits follow my transcript, with details
                    on recognized professional experience. Individual grades are
                    omitted. Credit values are expressed in university credits.
                  </p>
                  {[1, 2, 3].map(year => {
                    const subjects = education.coursework.filter(
                      subject => subject.year === year
                    );
                    return (
                      subjects.length > 0 && (
                        <section
                          class="mt-6"
                          aria-label={`Year ${year} academic activities`}
                        >
                          <h4 class="text-accent text-sm font-semibold">
                            Year {year}
                          </h4>
                          <ul class="border-border mt-3 divide-y border-y">
                            {subjects.map(subject => (
                              <li>
                                <details class="course-entry py-3">
                                  <summary class="flex cursor-pointer list-none flex-col items-center gap-3 rounded-sm py-1 md:flex-row md:items-start md:justify-between">
                                    <span
                                      lang={subject.language}
                                      class="text-sm leading-relaxed font-medium"
                                    >
                                      {subject.name}
                                    </span>
                                    <span class="text-muted-foreground shrink-0 text-xs leading-6">
                                      {subject.credits} credits{" "}
                                      <span
                                        aria-hidden="true"
                                        class="course-symbol text-accent ms-2 inline-block"
                                      >
                                        +
                                      </span>
                                    </span>
                                  </summary>
                                  <p class="reading-copy mt-3">
                                    {subject.description}
                                  </p>
                                </details>
                              </li>
                            ))}
                          </ul>
                        </section>
                      )
                    );
                  })}
                </details>
              </article>
            ))
          }
        </div>
        <section class="mt-8" aria-labelledby="credentials-title">
          <h3 id="credentials-title" class="text-accent text-xl font-semibold">
            Credentials & continued learning
          </h3>
          <p class="section-intro text-sm">
            Language assessment, technical courses and learning programmes
            listed on my LinkedIn profile. These complement my academic and
            professional experience.
          </p>
          <details class="content-card mt-5">
            <summary class="text-link w-fit cursor-pointer"
              >Explore {portfolio.credentials.length} selected credentials and programmes</summary
            >
            <ul class="mt-5 grid gap-4 md:grid-cols-2">
              {
                portfolio.credentials.map(credential => (
                  <li class="border-border border-t pt-4">
                    <h4 class="font-semibold">{credential.name}</h4>
                    <p class="text-muted-foreground mt-2 text-sm">
                      {credential.issuer} · {credential.issued}
                    </p>
                  </li>
                ))
              }
            </ul>
          </details>
        </section>
      </section>

      <section
        id="projects"
        data-tab-panel
        class="portfolio-section"
        aria-labelledby="projects-title"
      >
        <p class="eyebrow">Projects</p>
        <h2 id="projects-title" class="section-title">
          My work and contributions.
        </h2>
        <ProjectCarousel projects={portfolio.projects} />
      </section>

      <section
        id="capabilities"
        data-tab-panel
        class="portfolio-section"
        aria-labelledby="capabilities-title"
      >
        <p class="eyebrow">Capabilities</p>
        <h2 id="capabilities-title" class="section-title">
          Responsibilities across roles.
        </h2>
        <p class="section-intro">
          The responsibilities that run across my professional experience.
        </p>
        <div class="mt-7 grid gap-4 md:grid-cols-2">
          {
            portfolio.capabilities.map(capability => (
              <article class="content-card">
                <h3 class="text-accent text-lg font-semibold">
                  {capability.title}
                </h3>
                <p class="reading-copy mt-3">{capability.description}</p>
                <ul class="contributions text-muted-foreground mt-4 text-sm">
                  {capability.items.map(item => (
                    <li>{item}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <section id="toolkit" class="mt-10" aria-labelledby="toolkit-title">
          <p class="eyebrow">Toolkit</p>
          <h3 id="toolkit-title" class="section-title">
            Technologies used across projects.
          </h3>
          <p class="section-intro">
            Technologies from my CV. The experience above shows where I’ve used
            them.
          </p>
          <dl class="border-border mt-7 divide-y border-y">
            {
              portfolio.toolkit.map(group => (
                <div class="py-5">
                  <dt class="font-semibold">{group.title}</dt>
                  <dd class="text-muted-foreground mt-2 leading-relaxed">
                    {group.tools}
                  </dd>
                </div>
              ))
            }
          </dl>
        </section>
      </section>
    </portfolio-tabs>

    <section
      class="content-card mt-12"
      aria-labelledby="portfolio-contact-title"
    >
      <h2
        id="portfolio-contact-title"
        class="text-accent text-2xl leading-snug font-semibold"
      >
        Discuss a role or project.
      </h2>
      <p class="mt-3 max-w-xl leading-relaxed">
        Tell me about the context, the constraints and what you’re trying to
        achieve.
      </p>
      <a
        href={getRelativeLocaleUrl(locale, "contacts")}
        class="primary-link mt-5"
        >Start a conversation <span aria-hidden="true">↗</span></a
      >
    </section>
  </main>
  <Footer />
</Layout>

<script>
  import "@/scripts/portfolio-tabs";

  class PortfolioExplorer extends HTMLElement {
    #controller: AbortController | undefined;

    connectedCallback() {
      this.#controller?.abort();
      this.#controller = new AbortController();
      const { signal } = this.#controller;
      const controls = this.querySelector<HTMLElement>("[data-controls]");
      const expand = this.querySelector<HTMLButtonElement>("[data-expand]");
      const entries = [
        ...this.querySelectorAll<HTMLElement>("[data-experience]"),
      ];
      if (!controls || !expand || !entries.length) {
        throw new Error(
          "Portfolio explorer is missing its controls or experience entries."
        );
      }
      const details = entries.map(entry => {
        const detail = entry.querySelector<HTMLDetailsElement>("details");
        if (!detail)
          throw new Error(
            "Portfolio experience is missing its details element."
          );
        return detail;
      });

      const updateExpandLabel = () => {
        expand.textContent = details.every(detail => detail.open)
          ? "Collapse all roles"
          : "Expand all roles";
      };

      expand.addEventListener(
        "click",
        () => {
          const open = !details.every(detail => detail.open);
          for (const detail of details) detail.open = open;
          updateExpandLabel();
        },
        { signal }
      );

      this.addEventListener("toggle", updateExpandLabel, {
        capture: true,
        signal,
      });
      updateExpandLabel();
      // Native disclosures remain usable if enhancement cannot load.
      controls.hidden = false;
    }

    disconnectedCallback() {
      this.#controller?.abort();
    }
  }

  if (!customElements.get("portfolio-explorer")) {
    customElements.define("portfolio-explorer", PortfolioExplorer);
  }
</script>

<style>
  @reference "../styles/global.css";

  .portfolio {
    @apply text-center md:text-start;
    overflow-wrap: anywhere;
  }
  @media (width < 48rem) {
    .portfolio .reading-copy:not(ul):not(ol),
    .portfolio .section-intro {
      margin-inline: auto;
      text-align: center;
    }
    .portfolio summary.w-fit {
      margin-inline: auto;
    }
  }
  .eyebrow {
    @apply text-muted-foreground font-mono text-xs font-medium tracking-[0.06em] uppercase;
  }
  .section-title {
    @apply mt-3 text-2xl leading-snug font-semibold tracking-tight sm:text-3xl;
  }
  .section-intro {
    @apply reading-copy text-muted-foreground mt-4;
  }
  .portfolio-section {
    @apply pt-7 sm:pt-8;
    scroll-margin-top: 1.5rem;
  }
  @media (min-width: 768px) {
    .portfolio-section,
    .portfolio :target {
      scroll-margin-top: var(--portfolio-nav-offset, 9rem);
    }
  }
  .text-link {
    @apply text-accent underline decoration-solid underline-offset-4;
  }
  .primary-link {
    @apply bg-accent text-accent-foreground hover:bg-accent-hover inline-flex items-center justify-center gap-3 rounded-lg px-5 py-3 font-semibold motion-safe:transition-colors;
  }
  .section-navigation {
    @apply block md:sticky md:top-0 md:z-10;
  }
  .navigation-bar {
    @apply bg-background pt-3 pb-2;
  }
  .section-nav {
    @apply border-border flex flex-col gap-2 border-y py-2 md:flex-row;
  }
  .section-nav a {
    @apply border-input-border bg-surface text-foreground hover:bg-muted flex flex-1 items-center justify-center rounded-lg border px-3 py-3 text-center text-sm font-medium no-underline;
    min-block-size: 44px;
    @media (prefers-reduced-motion: no-preference) {
      transition:
        color 160ms var(--ease-state),
        background-color 160ms var(--ease-state),
        border-color 160ms var(--ease-state);
    }
  }
  .section-nav a[aria-selected="true"],
  .section-nav a[aria-current="location"] {
    @apply border-accent bg-accent text-accent-foreground hover:bg-accent-hover font-semibold;
  }
  .full-cv-button {
    @apply border-accent bg-muted text-foreground hover:bg-surface w-auto items-center justify-center gap-2 rounded-full border-2 px-5 py-2.5 text-center text-sm font-semibold;
    min-block-size: 44px;
    @media (prefers-reduced-motion: no-preference) {
      transition:
        color 160ms var(--ease-state),
        background-color 160ms var(--ease-state),
        border-color 160ms var(--ease-state);
    }
  }
  .full-cv-button:not([hidden]) {
    display: inline-flex;
  }
  .full-cv-button[aria-pressed="true"] {
    @apply bg-accent text-accent-foreground hover:bg-accent-hover;
  }
  @media (min-width: 768px) {
    .section-navigation[data-stuck] {
      /* Preserve the document position while only the visible toolbar shrinks. */
      block-size: var(--portfolio-expanded-navigation);
      pointer-events: none;
    }
    .section-navigation[data-stuck] .navigation-bar {
      @apply border-border flex items-center gap-2 border-b py-1;
      flex-wrap: wrap;
      pointer-events: auto;
    }
    .section-navigation[data-stuck] .navigation-actions {
      margin: 0;
      order: 2;
      flex: none;
      margin-inline-start: auto;
    }
    .section-navigation[data-stuck] #portfolio-sections-label {
      @apply sr-only;
    }
    .section-navigation[data-stuck] .section-nav {
      @apply min-w-0 flex-1 gap-1 border-0 py-0;
      flex-basis: 100%;
    }
    .section-navigation[data-stuck] .section-nav a {
      @apply border-transparent bg-transparent px-2 py-2 text-xs;
    }
    .section-navigation[data-stuck]
      .section-nav
      a:is([aria-selected="true"], [aria-current="location"]) {
      @apply bg-muted text-foreground;
    }
    .section-navigation[data-stuck] .full-cv-button {
      @apply border px-3 py-2 text-xs;
    }
    .section-navigation[data-stuck] .full-cv-button svg {
      @apply size-4;
    }
  }
  [data-tab-panel][hidden] {
    display: none;
  }
  @media print {
    .section-navigation {
      display: none;
    }
    [data-tab-panel][hidden] {
      display: block;
    }
  }
  .experience-timeline {
    @apply border-border md:ms-1 md:border-s md:ps-6;
  }
  .experience-timeline > li {
    position: relative;
    scroll-margin-top: 5rem;
  }
  .experience-timeline > li::before {
    content: "";
    @apply border-accent bg-background absolute top-7 -left-7.25 hidden size-2 rounded-full border md:block;
  }
  .role-overview,
  .contributions {
    max-inline-size: 65ch;
  }
  .content-card,
  .experience-card {
    @apply border-border bg-surface rounded-lg border;
  }
  .content-card {
    @apply p-5 sm:p-6;
  }
  .thesis-panel {
    @apply border-accent bg-muted rounded-r-lg border-s-2 py-4 ps-4 pe-4;
  }
  .experience-card > summary {
    @apply cursor-pointer list-none rounded-lg p-5 sm:p-6;
  }
  .experience-card > summary::-webkit-details-marker,
  .thesis-panel > summary::-webkit-details-marker {
    display: none;
  }
  .experience-card > summary:hover {
    @apply bg-muted;
  }
  .experience-card > summary:focus-visible,
  .portfolio :is(a, button, summary):focus-visible {
    @apply outline-accent outline-2 outline-offset-4 outline-solid;
  }
  .experience-body {
    @apply border-border mx-5 grid gap-6 border-t py-5 sm:mx-6 sm:py-6;
  }
  @media (min-width: 768px) {
    .experience-body {
      grid-template-columns: minmax(0, 1fr) 9rem;
      gap: 2rem;
    }
    .role-tools {
      @apply border-border border-s ps-5;
    }
    .role-tools ul {
      @apply flex-col items-start;
    }
  }
  .disclosure-icon {
    @apply text-accent inline-flex size-8 shrink-0 items-center justify-center rounded-full text-2xl leading-none;
    @media (prefers-reduced-motion: no-preference) {
      transition: transform 180ms var(--ease-state);
    }
  }
